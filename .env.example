# Student Learning Pattern Analysis — Environment Configuration
PROJECT_NAME="Student Learning Pattern Analysis"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./fyp.db

# Security & Authentication
# In production, generate a strong random key: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500
